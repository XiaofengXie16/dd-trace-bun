{
  "name": "dd-trace-bun",
  "version": "0.1.0",
  "description": "Datadog APM for Bun servers: dd-trace tracing for Bun.serve, Elysia and Hono, so distributed traces connect.",
  "keywords": ["bun", "datadog", "dd-trace", "apm", "tracing", "elysia", "hono"],
  "homepage": "https://github.com/XiaofengXie16/dd-trace-bun#readme",
  "bugs": "https://github.com/XiaofengXie16/dd-trace-bun/issues",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XiaofengXie16/dd-trace-bun.git"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./init": {
      "types": "./dist/init.d.ts",
      "default": "./dist/init.js"
    },
    "./elysia": {
      "types": "./dist/elysia.d.ts",
      "default": "./dist/elysia.js"
    }
  },
  "files": ["dist", "src"],
  "engines": {
    "bun": ">=1.2.23"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "bun run build",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "dd-trace": ">=5.60.0 <7",
    "elysia": ">=1.2.0"
  },
  "peerDependenciesMeta": {
    "elysia": { "optional": true }
  },
  "devDependencies": {
    "@msgpack/msgpack": "^3.0.0",
    "@types/bun": "^1.4.3",
    "dd-trace": "^6.20.1",
    "elysia": "^1.4.30",
    "typescript": "^5.9.3"
  }
}
